<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <item
        android:id="@+id/showQuestion"
        android:icon="@drawable/outline_help_outline_24"
        android:showAsAction="always"
        android:title="@string/show_question"
        tools:ignore="AlwaysShowAction" />

    <item
        android:id="@+id/showReply"
        android:icon="@drawable/ic_message3"
        android:showAsAction="always"
        android:title="@string/show_reply"
        tools:ignore="AlwaysShowAction" />

    <!-- 收藏 / 分享已挪到内容卡底栏（回复·点赞·收藏·转发），菜单里不再重复 -->
    <!-- 单帖第三方链接分享（Issue #18）：
         原来分享只在内容卡底栏的「转发」里 ✗ 详情页顶部看不到 ✗
         ⇒ 菜单里也放一个 ✓ 离线缓存里照样能用（那正是这个功能的价值 ✓）-->
    <!-- 离线缓存：详情页也能直接缓存（原来只能从列表卡片底栏进 ✗）
         缓存成功后会自动上云 ✓ 见 OfflineCacheRepo.autoCloud -->
    <item
        android:id="@+id/offlineCache"
        android:showAsAction="never"
        android:title="@string/offline_cache_title" />

    <item
        android:id="@+id/shareAsLink"
        android:showAsAction="never"
        android:title="@string/share_link_menu" />

    <item
        android:id="@+id/report"
        android:showAsAction="never"
        android:title="@string/report" />

    <item
        android:id="@+id/copyLink"
        android:showAsAction="never"
        android:title="@string/copyLink" />

    <!-- 编辑：默认隐藏，仅当 enableModify == 1 且是自己发的 才由 FeedFragment 打开 -->
    <item
        android:id="@+id/editFeed"
        android:showAsAction="never"
        android:title="编辑"
        android:visible="false" />

    <!-- 默认隐藏，仅在自己的动态详情页由 FeedFragment 打开 -->
    <item
        android:id="@+id/publishStatus"
        android:showAsAction="never"
        android:title="@string/change_publish_status"
        android:visible="false" />

    <item
        android:id="@+id/block"
        android:showAsAction="never"
        android:title="@string/block" />

</menu>
