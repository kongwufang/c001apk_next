<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="15dp"
    android:paddingTop="?attr/actionBarSize"
    android:paddingEnd="15dp"
    android:paddingBottom="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@color/cover"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/roundImageStyle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <!--
            话题 / 机型简介。原先塞在工具栏的 subtitle 里，而 CollapsingToolbarLayout
            会把工具栏的 subtitle 收进自己的折叠文字、按展开态画在头部下方，
            于是这行字直接压在头部卡片上（两块文字重叠）。
        -->
        <TextView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/followRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@color/cover"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/circleImageStyle" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="-8dp"
                android:background="@color/cover"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/circleImageStyle" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="-8dp"
                android:background="@color/cover"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/circleImageStyle" />

            <TextView
                android:id="@+id/followText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="&#8250;"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
        关注 / 已关注：官方的关注按钮在头部右侧（与标题齐平），
        背景色与文字色跟随关注状态在代码里设置（bindFollowBtn）。
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/followBtn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top"
        android:layout_marginStart="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="76dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="关注"
        android:textSize="13sp"
        app:cornerRadius="16dp" />
</LinearLayout>

