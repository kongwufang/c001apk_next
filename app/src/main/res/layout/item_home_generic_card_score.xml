<?xml version="1.0" encoding="utf-8"?>
<!--
    跑分卡（模板 subTabFeedCard2），照官方 Compose 的 ScoreGridCard 重画
    （反编译记录 _rev/jadx_c6/sources/defpackage/e5g.java 的 m2945，尺寸表见 _rev/SUBTAB_CARDS_SPEC.md）：

      · 两行，每行两格，水平间距 8dp、行间距 8dp，每格等宽（weight 1f）
      · 四格固定是：安兔兔跑分 / GeekBench 单核 / GeekBench 多核 / WildLife Extreme
      · 单格布局见 item_home_generic_card_score_item.xml

    格子由 GenericCardRenderer 按服务端 extraData 现填（缺哪个就不出哪格），所以这里只留
    两个空行容器，不写死 include，免得某格没数据时留下一个空壳。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/scoreRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/scoreRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

    </LinearLayout>

</layout>
