<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="isLogin"
            type="boolean" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null"
        android:fitsSystemWindows="false"
        app:consumeSystemWindowsInsets="end"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="end">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fitsSystemWindows="false"
            app:fitsSystemWindowsInsets="@integer/internal_fragment_top_insets">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin"
                app:title="@string/tab_mine">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/profileLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <Button
                        android:id="@+id/clickToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/click_to_login"
                        android:visibility="@{isLogin ? View.GONE : View.VISIBLE}"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="20dp"
                        android:background="@color/cover"
                        android:foreground="@drawable/selector_bg_avatar"
                        android:visibility="@{isLogin ? View.VISIBLE : View.INVISIBLE}"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearance="@style/circleImageStyle"
                        tools:ignore="ContentDescription" />

                    <!-- 自己的认证角标：本地只认维护者那条特例，代码里设 -->
                    <ImageView
                        android:id="@+id/verifyBadge"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_verify_badge"
                        android:contentDescription="@null"
                        android:padding="2dp"
                        android:src="@drawable/ic_verify_check"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/avatar"
                        app:layout_constraintEnd_toEndOf="@id/avatar" />

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:ellipsize="end"
                        android:lines="1"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="@{isLogin ? View.VISIBLE : View.INVISIBLE}"
                        app:layout_constraintEnd_toEndOf="@id/guideline"
                        app:layout_constraintStart_toEndOf="@+id/avatar"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="name" />

                    <!--
                        右上角图标的分界线（2026-10-24 修 ✓）

                        ## 原来按百分比 0.75 ✗
                        `layout_constraintGuide_percent="0.75"` 是**父宽的 75%** ✗
                        全屏时没问题（给右侧两个图标留 25% ✓）
                        但「我的」现在装进**侧边栏抽屉**（屏宽 85%）✗
                        ⇒ 75% 那条线几乎压在头像后面的文字上 ✗
                        ⇒ 用户名被截成「晚上...」✗
                        ⇒ `Lv.1` 和 `132/27000` **重叠糊在一起** ✗

                        ## 改成从右边固定留 100dp ✓
                        右上角两个图标（账号 + 设置）各 48dp ⇒ 96dp 就够 ✓
                        用固定值不随父宽缩放 ⇒ 全屏 / 抽屉 / 分屏都对 ✓
                    -->
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_end="100dp" />

                    <TextView
                        android:id="@+id/level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="6dp"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="@{isLogin ? View.VISIBLE : View.INVISIBLE}"
                        app:layout_constraintStart_toEndOf="@+id/avatar"
                        app:layout_constraintTop_toBottomOf="@id/name"
                        tools:text="Lv.1" />

                    <TextView
                        android:id="@+id/exp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="10sp"
                        android:visibility="@{isLogin ? View.VISIBLE : View.INVISIBLE}"
                        app:layout_constraintEnd_toEndOf="@id/guideline"
                        app:layout_constraintTop_toTopOf="@id/level"
                        tools:ignore="NestedWeights"
                        tools:text="500/1000" />

                    <!--
                        等级进度条，按桌面版做成一条连续的条。M3E 的 linearProgressIndicatorStyle
                        （见 themes_m3e.xml）继承的是 M3 那套：指示器与轨道之间留 indicatorTrackGapSize
                        的空隙、两侧各自收圆角（看着就是"中间断开"），外加轨道末端一个停止指示点。
                        所以要三处覆盖：
                          indicatorTrackGapSize=0dp  去掉中缝
                          trackInnerCornerRadius=0dp 接缝两侧改成直角，否则半圆对半圆会留上下凹口
                          trackStopIndicatorSize=0dp 去掉末端光点（组件默认值本就是 0）
                        trackCornerRadius 保留，只管整条两端的外圆角。
                        注意：间隙为 0 时若把 indeterminateAnimationType 改成 contiguous，validateSpec
                        会抛异常；继承链里是 disjoint，别去动它。
                    -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="6dp"
                        android:visibility="@{isLogin ? View.VISIBLE : View.INVISIBLE}"
                        app:indicatorTrackGapSize="0dp"
                        app:layout_constraintEnd_toEndOf="@id/guideline"
                        app:layout_constraintStart_toEndOf="@id/avatar"
                        app:layout_constraintTop_toBottomOf="@id/level"
                        app:trackCornerRadius="20dp"
                        app:trackInnerCornerRadius="0dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="5dp"
                        tools:max="1000"
                        tools:progress="500" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.appbar.MaterialToolbar>

            <!--
                2026-10-05：页面按桌面版重排——消息入口搬去首页工具栏、
                通知列表独立成 MessageCenterActivity，这里只剩个人中心
                （头部用户卡 + 统计卡 + 功能宫格）。宫格见 item_mine_menu.xml。
            -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="?attr/colorSurfaceVariant" />

        </com.google.android.material.appbar.AppBarLayout>

        <com.example.c001apk.view.CustomViewFlipper
            android:id="@+id/vf_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    app:fitsSystemWindowsInsets="bottom" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </com.example.c001apk.view.CustomViewFlipper>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>