<?xml version="1.0" encoding="utf-8"?>
<!--
    侧栏「升级卡片」（2026-11-01 新增）

    ## 需求（用户原话）
    >「升级卡片的话由于已经有叉了，所以只需要两个按钮，变成跳过此版本和下载，
    >  不再提醒按钮取消」
    >「APP 进入之后自动检查更新就不跳窗口了，只显示在侧栏，减少打扰」
    >「在关于页面点击立即检查更新，就还是跳旧的窗口，只不过按钮修改」

    ## 语义
      · ⚠️ **这张卡没有叉** ✗（2026-11-01 用户要求：「升级的卡片是不能有叉的，
        所以用户只能通过选择下面两个按钮」）
         ⇒ 只能点「跳过此版本」或「下载」，不给"随手划掉"的机会 ✓
         ⇒ 公告卡**有**叉（已读隐藏 ✓）两者不一样 ✓
      · 「下载」= 跳外部浏览器（多线路时先弹线路选择 ✓ 沿用旧逻辑 ✓）
      · 没有「不再提醒」✗ 想彻底关掉得去设置里关「检查更新」✓（提升更新积极性 ✓）
      ⚠️ **绝对不要**在这张卡片上加 layout_margin ✗（2026-11-01 踩过）
         RecyclerView 已经挂了 `LinearItemDecoration(10dp)` ⇒ 它会给**每个** item
         加上 left/right/bottom 各 10dp ✓
         这里再加 margin ⇒ 变成 20dp ⇒ 比上面的九宫格窄一圈 ✗
         用户原话：「这个卡片我想跟上面的卡片共宽，看起来视觉比较舒适」
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="发现新版本 1.0.8" />

        </LinearLayout>

        <TextView
            android:id="@+id/changelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="6"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="· 修复了 xxx" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/update_skip_version"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/download"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/download"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
