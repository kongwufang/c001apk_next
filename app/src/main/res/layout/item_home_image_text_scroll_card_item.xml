<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="data"
            type="com.example.c001apk.logic.model.HomeFeedResponse.Entities" />

        <variable
            name="listener"
            type="com.example.c001apk.adapter.ItemListener" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{(view) -> listener.onViewFeed(view, data.id, data.userInfo.uid, data.userInfo.username, data.userInfo.userAvatar, data.deviceTitle, data.message, String.valueOf(data.dateline), null, null, null)}"
        android:foreground="@drawable/selector_bg_12_trans">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageTextScrollCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/cover"
            android:scaleType="centerCrop"
            app:setImage="@{data.pic}"
            app:layout_constraintDimensionRatio="H, 649:291"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/textScrollImgRadius" />

        <TextView
            android:id="@+id/title"
            android:text="@{data.title}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_text_scroll_card_text_bg"
            android:maxLines="2"
            android:padding="10dp"
            android:minLines="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageTextScrollCard" />

        <!-- 公共黑名单红带（2026-10-31 用户要求：优质图文也要）✓
             ⚠️ 只隐藏封面和标题 ✓ 这两个 View 的 visibility **没有** databinding 绑定 ✓
                所以不会被 BindingAdapter 设回来 ✓（踩过的坑不会重现）-->
        <TextView
            android:id="@+id/blockedBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#F2FFEBEE"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/blocked_multi_report"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>