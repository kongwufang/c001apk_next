<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
        <import type="com.example.c001apk.util.UserCardUtils" />
        <import type="com.example.c001apk.util.DateUtils" />

        <variable
            name="listener"
            type="com.example.c001apk.adapter.ItemListener" />

        <variable
            name="userData"
            type="com.example.c001apk.logic.model.UserProfileResponse.Data" />

        <!-- 是不是自己的主页：是则关注按钮变成「编辑信息」 -->
        <variable
            name="isSelf"
            type="boolean" />
    </data>

    <!-- 铺在封面图上的整块头部：封面 + 头像 + 昵称/认证/简介 + 数据 + 性别地区 + 装备条 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/infoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        app:layout_collapseMode="parallax">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fitsSystemWindows="true"
            android:onClick="@{(view) -> listener.loadImage(view, userData.cover)}"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:setCover="@{userData.cover}"
            tools:ignore="ContentDescription" />

        <!-- 让封面上的白字始终可读 -->
        <View
            android:id="@+id/scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#4D000000"
            app:layout_constraintBottom_toBottomOf="@id/cover"
            app:layout_constraintEnd_toEndOf="@id/cover"
            app:layout_constraintStart_toStartOf="@id/cover"
            app:layout_constraintTop_toTopOf="@id/cover" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="?attr/actionBarSize"
            android:background="@color/cover"
            android:foreground="@drawable/selector_bg_avatar"
            android:onClick="@{(view) -> listener.loadImage(view, userData.userAvatar)}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:setImage="@{userData.userAvatar}"
            app:shapeAppearance="@style/circleImageStyle"
            tools:ignore="ContentDescription" />

        <!-- 认证角标：压在主页大头像右下角，没认证时 GONE -->
        <ImageView
            android:id="@+id/verifyBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_verify_badge"
            android:contentDescription="@null"
            android:padding="3dp"
            android:src="@drawable/ic_verify_check"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/avatar"
            app:layout_constraintEnd_toEndOf="@id/avatar"
            app:verifyIcon="@{userData.verifyIcon}"
            app:verifyStatus="@{userData.verifyStatus}"
            app:verifyUid="@{userData.uid}" />

        <TextView
            android:id="@+id/followBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_user_follow"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@{isSelf ? `编辑信息` : (userData.isFollow == 1 ? `已关注` : `关注`)}"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/avatar"
            app:layout_constraintEnd_toStartOf="@id/mailBtn" />

        <!--
            私信圆钮：在关注按钮右侧（自己的主页不显示）。
            从没聊过的人也能点进来发第一条消息，由服务端隐式建会话。
        -->
        <ImageView
            android:id="@+id/mailBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_user_mail"
            android:padding="7dp"
            android:src="@drawable/ic_mail"
            app:layout_constraintBottom_toBottomOf="@id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />

        <!--
            昵称 + 等级徽章：整行放在头像正下方，左边距与其他信息行一致（16dp）。
            之前是在 ConstraintLayout 里用 name↔level 双向约束（隐式水平链），
            渲染出来昵称会被链推到中间，和下面的简介左边距对不齐，所以改成 LinearLayout。
        -->
        <LinearLayout
            android:id="@+id/nameRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/avatar">

            <TextView
                android:id="@+id/name"
                style="@style/UserTextColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="200dp"
                android:text="@{userData.username}"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_user_chip"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@{`Lv.` + userData.level}"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 认证行（角标 + 文字）只在这里（个人主页）出现：列表 / 详情页只挂头像右下角那枚角标。
             走 adapter 而不是直接绑 verifyTitle，是因为本地特例那条认证服务端不下发 -->
        <LinearLayout
            android:id="@+id/verifyTitleRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nameRow"
            app:verifyTitle="@{userData}">

            <!-- 与头像右下角同款、同色，颜色由 adapter 按认证类型设 -->
            <ImageView
                android:id="@+id/verifyTitleBadge"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:background="@drawable/bg_verify_badge"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/ic_verify_check" />

            <TextView
                android:id="@+id/verifyTitleText"
                style="@style/UserTextColor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
            签名 + 展开按钮：按钮排在签名文段之后（左对齐、紧跟文段下方），用主题色。

            原来是把按钮钉在父容器右边缘、与签名垂直居中，签名短的时候按钮会孤零零悬在
            离文字很远的地方，看不出它是「这段文字的展开」。移到文段后面之后它跟着文字走，
            左边缘与签名对齐。

            按钮 GONE 而不是 INVISIBLE：放在签名下方就不再挤占签名的可用宽度，
            「要不要展开」的判定不会因为按钮自己的显隐而改变（旧写法是并排在右侧，
            必须常驻占位才不成反馈环）。判定见 UserPagerFragment.bindBio。
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bioLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/verifyTitleRow">

            <TextView
                android:id="@+id/bio"
                style="@style/UserTextColor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@{userData.bio}"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/bioExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minHeight="28dp"
                android:text="展开"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/bio"
                app:layout_constraintTop_toBottomOf="@id/bio" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bioLayout">

            <TextView
                style="@style/UserStatNum"
                android:text="@{UserCardUtils.countText(userData.beLikeNum)}" />

            <TextView
                style="@style/UserStatLabel"
                android:layout_marginEnd="8dp"
                android:text="获赞" />

            <!--
                关注 / 粉丝：数字和文字整块做成可点热区（原来只有数字可点，太难点中）。
                padding + minHeight 把热区撑到 40dp 高，标签自带的 marginEnd 在组内清零。
            -->
            <LinearLayout
                android:id="@+id/followGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:onClick="@{(view) -> listener.viewFFFList(view, userData.uid, true, `follow`)}"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/UserStatNum"
                    android:text="@{UserCardUtils.countText(userData.follow)}" />

                <TextView
                    style="@style/UserStatLabel"
                    android:layout_marginEnd="0dp"
                    android:text="关注" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fansGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:onClick="@{(view) -> listener.viewFFFList(view, userData.uid, true, `fans`)}"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/UserStatNum"
                    android:text="@{UserCardUtils.countText(userData.fans)}" />

                <TextView
                    style="@style/UserStatLabel"
                    android:layout_marginEnd="0dp"
                    android:text="粉丝" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/stats">

            <TextView
                style="@style/UserChip"
                android:text="@{UserCardUtils.genderText(userData.gender)}"
                android:visibility="@{UserCardUtils.genderText(userData.gender).isEmpty() ? View.GONE : View.VISIBLE}" />

            <TextView
                style="@style/UserChip"
                android:text="@{UserCardUtils.regionText(userData.province, userData.city)}"
                android:visibility="@{UserCardUtils.regionText(userData.province, userData.city).isEmpty() ? View.GONE : View.VISIBLE}" />

            <TextView
                style="@style/UserChip"
                android:text="@{DateUtils.fromToday(userData.logintime) + `活跃`}" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/equipLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_user_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="@{userData.productOwnerCount == null ? View.GONE : View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chips">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="他的装备"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{UserCardUtils.equipText(userData.productOwnerCount)}"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:rotation="-90"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
