<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    app:consumeSystemWindowsInsets="end"
    app:edgeToEdge="true"
    app:fitsSystemWindowsInsets="end">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:fitsSystemWindows="false"
        app:fitsSystemWindowsInsets="@integer/internal_fragment_top_insets">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!--
                「我的」入口（2026-10-24 UI 大改 ✓）

                用户要求：「在首页搜索和消息按钮那一栏的最左边增加我的按钮」
                ⇒ 位置就是 search / message 那一排的**最左边** ✓
                ⇒ 点它拉出侧边栏抽屉（内容 = 原「我的」整页 ✓）

                图标用 ic_menu（☰）✓ 跟 rikkahub 主页左上角一致 ✓
            -->
            <ImageView
                android:id="@+id/mine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:background="?actionBarItemBackground"
                android:contentDescription="@string/tab_mine"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                android:tooltipText="@string/tab_mine"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                style="@style/Widget.Material3.TabLayout.OnSurface.Trans"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/search"
                app:layout_constraintStart_toEndOf="@id/mine"
                app:layout_constraintTop_toTopOf="parent"
                app:tabGravity="fill"
                app:tabMinWidth="0dp"
                app:tabMode="auto"
                app:tabTextAppearance="@style/TabText" />

            <ImageView
                android:id="@+id/search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="?actionBarItemBackground"
                android:src="@drawable/ic_search"
                android:tooltipText="@string/search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/message"
                app:layout_constraintStart_toEndOf="@id/tabLayout"
                app:layout_constraintTop_toTopOf="parent" />

            <!--
                2026-10-05：这里原来是「编辑Tab」入口，已挪到 设置 → 外观。
                现在放消息入口，右上角挂未读数字红点（messageBadge 由 HomeFragment
                按 UnreadCounter.total 控制，口径与消息中心宫格同源）。
            -->
            <FrameLayout
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?actionBarItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:tooltipText="@string/message_center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/message_center"
                    android:src="@drawable/ic_message_outline" />

                <TextView
                    android:id="@+id/messageBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/badge_red"
                    android:gravity="center"
                    android:minWidth="15dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="9" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="?attr/colorSurfaceVariant" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>