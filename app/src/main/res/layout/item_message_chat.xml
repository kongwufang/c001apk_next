<?xml version="1.0" encoding="utf-8"?>
<!--
    一条私信消息。isMe 由 adapter 按 fromuid 判断后传进来：
    自己发的靠右（主题色气泡），对方发的靠左（浅色气泡），系统提示居中。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="com.example.c001apk.util.MessageKit" />

        <variable
            name="data"
            type="com.example.c001apk.logic.model.MessageResponse.Data" />

        <variable
            name="isMe"
            type="Boolean" />

        <!-- 对方头像 / 我的头像，由 adapter 用会话信息传入（聊天记录里没有可靠的头像字段） -->
        <variable
            name="partnerAvatar"
            type="String" />

        <variable
            name="myAvatar"
            type="String" />

        <!-- 对方的 uid，同样由 adapter 用会话信息传入（认证角标按它查，聊天记录里没有） -->
        <variable
            name="partnerUid"
            type="String" />

        <!--
            发送状态（ChatItem.STATE_*）：
              0 = 已发送（什么都不显示）
              1 = 发送中（气泡左侧转圈）
              2 = 发送失败（换成红色感叹号，点一下问是否重发）
            ⚠️ 0/1/2 三个数字必须和 ChatItem 里的常量一致
        -->
        <variable
            name="state"
            type="int" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <!-- 系统提示（messageExtra）居中一行灰字 -->
        <TextView
            android:id="@+id/systemText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@{MessageKit.extraText(data)}"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:visibility="@{MessageKit.isExtra(data) ? View.VISIBLE : View.GONE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="你们已经是好友了"
            tools:visibility="gone" />

        <!-- 对方：头像靠左 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatarLeft"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/cover"
            android:contentDescription="@null"
            android:visibility="@{isMe || MessageKit.isExtra(data) ? View.GONE : View.VISIBLE}"
            app:avatarImage="@{partnerAvatar}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/circleImageStyle"
            tools:visibility="visible" />

        <!--
            对方头像上的认证角标，没认证时 GONE。
            可见性只由角标那一支适配器写：自己发的消息 / 系统提示这两种情况下
            对方头像是 GONE 的，所以 uid 也跟着一起收（给空串），
            否则角标会孤零零浮在左边。
            /v6/message/chat 不下发认证字段，这里只按 uid 查云端认证表。
        -->
        <ImageView
            android:id="@+id/verifyBadge"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_verify_badge"
            android:contentDescription="@null"
            android:padding="2dp"
            android:src="@drawable/ic_verify_check"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/avatarLeft"
            app:layout_constraintEnd_toEndOf="@id/avatarLeft"
            app:verifyUid="@{MessageKit.badgeUid(data, isMe, partnerUid)}" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bubbleLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="48dp"
            android:visibility="@{isMe || MessageKit.isExtra(data) ? View.GONE : View.VISIBLE}"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/avatarLeft"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!--
                    正文必须用 LinkTextView：服务端把消息当 HTML 下发，
                    纯文本消息里带链接时是 <a class="feed-link-url" href="...">查看链接</a>，
                    普通 TextView 会把标签原样显示出来。LinkTextView 内部统一走
                    SpannableStringBuilderUtil（HTML / Markdown / [表情] / 链接可点）。
                -->
                <com.example.c001apk.view.LinkTextView
                    android:id="@+id/textLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@{data.message}"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:visibility="@{MessageKit.hasPic(data) ? View.GONE : View.VISIBLE}"
                    app:linkAsChip="true"
                    tools:text="在吗" />

                <!--
                    图片消息正文是空的，这一行换成图片。地址不能直接用 message_pic（CDN 要 auth_key），
                    得先问 showImage 换签名地址，换完由 adapter 塞进来（见 MessageDetailAdapter）。

                    宽高：adapter 量到图片真实像素时会按比例把 layoutParams 定死（量到了就不跳）；
                    量不到时这里必须自己能撑住 —— adjustViewBounds=true + wrap_content + 上限，
                    让 ImageView 直接跟着解码出来的位图比例走。**别写死方形尺寸**，
                    否则一量不到就退成方块（之前就是这么坏的）。
                    点一下由 adapter 交给 ImageUtil.startChatBigImgViewSimple 全屏看。
                -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/picLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:maxHeight="260dp"
                    android:maxWidth="220dp"
                    android:minHeight="72dp"
                    android:minWidth="72dp"
                    android:scaleType="fitCenter"
                    android:visibility="@{MessageKit.hasPic(data) ? View.VISIBLE : View.GONE}"
                    app:shapeAppearance="@style/chatImageStyle"
                    tools:src="@tools:sample/avatars" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!--
            发送中：气泡左侧的小转圈。
            bubbleRight 的 layout_marginStart 是 48dp，这里正好有位置 ✓
            android:indeterminateTint 用主题色，跟气泡一致
        -->
        <ProgressBar
            android:id="@+id/sendProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="@{state == 1 &amp;&amp; isMe ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="@id/bubbleRight"
            app:layout_constraintEnd_toStartOf="@id/bubbleRight"
            app:layout_constraintTop_toTopOf="@id/bubbleRight"
            tools:visibility="gone" />

        <!-- 发送失败：红色感叹号，adapter 给它挂点击（弹「是否重新发送」） -->
        <ImageView
            android:id="@+id/sendFailed"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="发送失败，点击重新发送"
            android:src="@drawable/ic_chat_send_failed"
            android:tint="?attr/colorError"
            android:visibility="@{state == 2 &amp;&amp; isMe ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="@id/bubbleRight"
            app:layout_constraintEnd_toStartOf="@id/bubbleRight"
            app:layout_constraintTop_toTopOf="@id/bubbleRight"
            tools:visibility="gone" />

        <!-- 自己：气泡靠右 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bubbleRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="8dp"
            android:visibility="@{isMe &amp;&amp; !MessageKit.isExtra(data) ? View.VISIBLE : View.GONE}"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/avatarRight"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 正文用 LinkTextView，理由见上面左侧气泡的注释 -->
                <com.example.c001apk.view.LinkTextView
                    android:id="@+id/textRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@{data.message}"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="15sp"
                    android:visibility="@{MessageKit.hasPic(data) ? View.GONE : View.VISIBLE}"
                    app:linkAsChip="true"
                    tools:text="在的" />

                <!-- 尺寸与点击行为同 picLeft：能定死就按图片比例定死，定不死靠 adjustViewBounds 自己撑 -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/picRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:maxHeight="260dp"
                    android:maxWidth="220dp"
                    android:minHeight="72dp"
                    android:minWidth="72dp"
                    android:scaleType="fitCenter"
                    android:visibility="@{MessageKit.hasPic(data) ? View.VISIBLE : View.GONE}"
                    app:shapeAppearance="@style/chatImageStyle"
                    tools:src="@tools:sample/avatars" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatarRight"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/cover"
            android:contentDescription="@null"
            android:visibility="@{isMe &amp;&amp; !MessageKit.isExtra(data) ? View.VISIBLE : View.GONE}"
            app:avatarImage="@{myAvatar}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/circleImageStyle"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
