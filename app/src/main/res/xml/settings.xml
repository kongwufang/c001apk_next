<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        2026-10-05 修正：一级菜单只保留「入口」，点进去才是具体开关。
        嵌套 PreferenceScreen 由 SettingsPreferenceFragment.onNavigateToScreen 交给
        独立 Activity（SettingsDetailActivity）打开，与「关于」页一样走系统的跨 Activity
        预测性返回，右滑时可跟手预览（Fragment 返回栈 + res/anim 是拿不到预览的）。
        顺序：外观 / 推荐流相关 / 隐私 / 高级 / 其他 / 关于
        「关于」已提到一级：点击直接打开 AboutActivity（去掉了
        其他 → 关于 → 关于本应用 中间那两层无用目录）。
    -->

    <PreferenceScreen
        android:icon="@drawable/outline_palette_24"
        android:key="appearance"
        android:title="@string/settings_appearance">

        <!--
            2026-10-06：外观屏条目变多之后按用途分组（主题 / 显示 / 布局 / 转场动画），
            转场那三项再收进一层子菜单，免得一级外观页被实验项撑满。
        -->
        <PreferenceCategory android:title="@string/settings_theme">

        <!-- ★ 2026-11-08 用户要求：外面不再放开关，所有日志操作都在「日志」页里 -->
        <Preference
            android:icon="@drawable/ic_bug"
            android:key="logCenter"
            android:summary="级别 / 模块 / 查看 / 导出 / 清空"
            android:title="日志" />

    </PreferenceScreen>

    <PreferenceScreen
        android:icon="@drawable/ic_more"
        android:key="other"
        android:title="@string/settings_other">

        <Preference
            android:icon="@drawable/ic_clean"
            android:key="clearCache"
            android:title="@string/clear_cache" />

    </PreferenceScreen>

    <!-- 一级「关于」：点击直接进关于页（更新开关 / 立即检查 / 组织按钮都在里面） -->
    <Preference
        android:icon="@drawable/ic_logo"
        android:key="about"
        android:title="@string/about" />

</PreferenceScreen>
